<project
	xmlns="http://maven.apache.org/POM/4.0.0"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

  <modelVersion>4.0.0</modelVersion>

  <groupId>de.eldecker</groupId>
  <artifactId>lied-details</artifactId>
  <version>0.0.1-SNAPSHOT</version>

  <name>lied-details</name>
  <description>Lied-Details von KI/LLM abfragen</description>
  <url>https://github.com/MDecker-MobileComputing/Maven_LiedDetailsVonKI</url>
  <inceptionYear>2026</inceptionYear>
  <licenses>
    <license>
      <name>BSD 3-Clause License</name>
      <url>https://opensource.org/license/BSD-3-clause/</url>
    </license>
  </licenses>
      
  <properties>
      <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
      <maven.compiler.source>21</maven.compiler.source>
      <maven.compiler.target>21</maven.compiler.target>
  </properties>


  <dependencies>

    <!-- neueste Version siehe https://mvnrepository.com/artifact/io.github.sashirestela/simple-openai/versions-->
    <dependency>
      <groupId>io.github.sashirestela</groupId>
      <artifactId>simple-openai</artifactId>
      <version>3.22.2</version>
    </dependency>

  </dependencies>
  
  <build>
    <plugins>
        <plugin>
            <!-- "Fat Jar" bauen, wenn Befehl "mvnw package" ausgeführt wird
                 Das "Fat Jar" sollte sich danach im Ordner "target" befinden und wird wie folgt ausgeführt:
                 java -jar lied-details-0.0.1-SNAPSHOT-jar-with-dependencies.jar
              -->
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-assembly-plugin</artifactId>
            <version>3.8.0</version><!-- Für neueste Version siehe https://mvnrepository.com/artifact/org.apache.maven.plugins/maven-assembly-plugin -->
            <configuration>
                <descriptorRefs>
                    <descriptorRef>jar-with-dependencies</descriptorRef>
                </descriptorRefs>
                <archive>
                  <manifest>
                    <mainClass>de.eldecker.lieddetails.Main</mainClass>
                  </manifest>
                </archive>
            </configuration>
            <executions>
                <execution>
                    <id>assemble-all</id>
                    <phase>package</phase>
                    <goals>
                        <goal>single</goal>
                    </goals>
                </execution>
            </executions>
        </plugin>
    </plugins>
  </build>  

</project>